<?xml version="1.0" encoding="utf-8"?>
<!--
    Las bases (SQLCipher) y las preferencias cifradas dependen de una clave de Android Keystore
    que no sale del dispositivo: copiarlas a otro equipo solo trasladaría datos ilegibles.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
